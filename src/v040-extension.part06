
/* Deep GLT symbol + control layer ------------------------------------------------ */
(() => {
  "use strict";
  const Card = customElements.get("glt-flow-card");
  const Editor = customElements.get("glt-flow-card-editor");
  if (!Card || !Editor) return;

  const DETAIL_SYMBOLS = [
    ["pump_inline","Pumpe · Inline","Hydraulik"],["pump_twin","Doppelpumpe","Hydraulik"],["pump_variable","Pumpe · FU geregelt","Hydraulik"],
    ["valve_2way","2-Wege-Ventil","Hydraulik"],["valve_3way","3-Wege-Ventil","Hydraulik"],["mixing_valve","3-Wege-Mischer mit Antrieb","Hydraulik"],
    ["shutoff_valve","Absperrventil","Hydraulik"],["check_valve","Rückschlagventil","Hydraulik"],["safety_valve","Sicherheitsventil","Hydraulik"],
    ["hydraulic_separator","Hydraulische Weiche","Hydraulik"],["heat_exchanger_plate","Plattenwärmetauscher","Hydraulik"],["manifold","Verteiler / Sammler","Hydraulik"],
    ["filter_water","Schmutzfänger","Hydraulik"],["dirt_separator","Schlamm-/Magnetitabscheider","Hydraulik"],["expansion_vessel","Ausdehnungsgefäß","Hydraulik"],
    ["buffer_layered","Schichtspeicher","Heizung"],["dhw_tank","Warmwasserspeicher","Heizung"],["immersion_heater","Heizstab","Heizung"],
    ["boiler","Heizkessel","Heizung"],["burner","Brenner","Heizung"],["underfloor","Fußbodenheizung","Heizung"],["radiator","Heizkörper","Heizung"],
    ["fan_supply","Zuluftventilator","RLT"],["fan_extract","Abluftventilator","RLT"],["damper","Luftklappe","RLT"],["fire_damper","Brandschutzklappe","RLT"],
    ["air_filter","Luftfilter","RLT"],["heating_coil","Heizregister","RLT"],["cooling_coil","Kühlregister","RLT"],["heat_recovery_rotary","Rotationswärmetauscher","RLT"],
    ["heat_recovery_plate","Platten-WRG","RLT"],["humidifier","Befeuchter","RLT"],["silencer","Schalldämpfer","RLT"],
    ["chiller","Kältemaschine","Kälte"],["compressor","Verdichter","Kälte"],["cooling_tower","Kühlturm","Kälte"],
    ["pv_array","PV-Feld","Energie"],["inverter","Wechselrichter","Energie"],["battery","Batteriespeicher","Energie"],["grid","Netz","Energie"],["meter","Energiezähler","Energie"],
    ["temp_sensor","Temperaturfühler","Sensorik"],["pressure_sensor","Drucksensor","Sensorik"],["dp_sensor","Differenzdruck","Sensorik"],["flow_sensor","Volumenstrom","Sensorik"],
    ["humidity_sensor","Feuchtefühler","Sensorik"],["co2_sensor","CO₂-Sensor","Sensorik"],["frost_thermostat","Frostschutzthermostat","Sensorik"]
  ];

  const svg = (body, active=false, extra="") => `<svg viewBox="0 0 64 64" class="glt-detail-svg ${active?"is-active":""} ${extra}" aria-hidden="true">${body}</svg>`;
  const L = (x1,y1,x2,y2,cls="") => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" class="${cls}"/>`;
  const P = (d,cls="") => `<path d="${d}" class="${cls}"/>`;
  const R = (x,y,w,h,rx=2,cls="") => `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx}" class="${cls}"/>`;
  const C = (cx,cy,r,cls="") => `<circle cx="${cx}" cy="${cy}" r="${r}" class="${cls}"/>`;

  function symbolSvg(id, active=false) {
    const s = String(id || "").toLowerCase();
    if (["pump","pump_inline","pump_circulation","pump_dhw","pump_variable"].includes(s))
      return svg(`${C(32,32,19,"body")}${P("M24 43 L24 21 L44 32 Z","accent rotor")}${L(4,32,13,32)}${L(51,32,60,32)}${s==="pump_variable"?'<text x="39" y="16" class="txt">FU</text>':""}`,active,"pump");
    if (s==="pump_twin") return svg(`${C(22,32,13,"body")}${C(42,32,13,"body")}${P("M17 39 L17 25 L29 32 Z","accent rotor")}${P("M37 39 L37 25 L49 32 Z","accent rotor")}${L(3,32,9,32)}${L(55,32,61,32)}`,active,"pump twin");
    if (["valve","valve_2way","shutoff_valve"].includes(s)) return svg(`${L(3,32,15,32)}${P("M15 20 L32 32 L15 44 Z","body")}${P("M49 20 L32 32 L49 44 Z","body")}${L(49,32,61,32)}`,active,"valve");
    if (["valve_3way","mixing_valve"].includes(s)) return svg(`${P("M10 20 L29 32 L10 44 Z","body")}${P("M48 20 L29 32 L48 44 Z","body")}${P("M20 54 L29 32 L38 54 Z","body")}${L(2,32,10,32)}${L(48,32,61,32)}${L(29,54,29,62)}${s==="mixing_valve"?`${R(23,4,12,10,2,"actuator")}${L(29,14,29,28)}`:""}`,active,"valve three");
    if (s==="check_valve") return svg(`${L(3,32,16,32)}${P("M16 20 L37 32 L16 44 Z","body")}${L(40,19,40,45,"accent")}${L(40,32,61,32)}`,active);
    if (s==="safety_valve") return svg(`${L(5,38,23,38)}${P("M23 28 L36 38 L23 48 Z","body")}${L(38,24,38,52,"accent")}${P("M38 24 C45 20 45 14 52 11 M48 8 L54 12 L49 16","accent")}`,active);
    if (s==="hydraulic_separator") return svg(`${R(22,7,20,50,8,"tank")}${L(3,19,22,19,"hot")}${L(42,19,61,19,"hot")}${L(3,45,22,45,"cold")}${L(42,45,61,45,"cold")}${P("M28 18 C35 24 29 31 36 37 C39 40 37 46 32 49","accent")}`,active);
    if (["heat_exchanger","heat_exchanger_plate","heat_recovery_plate"].includes(s)) return svg(`${R(13,8,38,48,2,"body")}${P("M19 14 L45 50 M45 14 L19 50 M25 10 L25 54 M39 10 L39 54","thin")}${L(3,20,13,20,"hot")}${L(51,20,61,20,"hot")}${L(3,44,13,44,"cold")}${L(51,44,61,44,"cold")}`,active);
    if (s==="manifold") return svg(`${R(10,24,44,16,5,"body")}${[15,24,33,42,51].map(x=>`${L(x,12,x,24)}${L(x,40,x,52)}`).join("")}`,active);
    if (["filter_water","dirt_separator","air_filter"].includes(s)) return svg(`${R(15,13,34,38,2,"body")}${P("M18 47 L46 17 M25 49 L49 25 M15 39 L39 15","thin")}${L(3,32,15,32)}${L(49,32,61,32)}`,active);
    if (s==="expansion_vessel") return svg(`${C(32,32,23,"tank")}${P("M10 32 Q32 21 54 32 Q32 43 10 32","accent")}${L(32,55,32,62)}`,active);
    if (["tank","buffer_vertical","buffer_layered","cooling_buffer"].includes(s)) return svg(`${P("M18 9 Q18 4 32 4 Q46 4 46 9 L46 55 Q46 60 32 60 Q18 60 18 55 Z","tank")}${R(20,10,24,20,0,"hotfill")}${R(20,34,24,20,0,"coldfill")}${L(8,18,18,18,"hot")}${L(8,47,18,47,"cold")}${L(46,18,56,18,"hot")}${L(46,47,56,47,"cold")}`,active);
    if (s==="dhw_tank") return svg(`${P("M18 9 Q18 4 32 4 Q46 4 46 9 L46 55 Q46 60 32 60 Q18 60 18 55 Z","tank")}${P("M24 42 C24 34 40 34 40 26 C40 18 24 18 24 11","accent coil")}${L(8,14,18,14,"hot")}${L(46,50,56,50,"cold")}`,active);
    if (["immersion_heater","electric_heater"].includes(s)) return svg(`${L(3,32,16,32)}${R(16,12,32,40,3,"body")}${P("M22 40 L27 24 L32 40 L37 24 L42 40","accent")}${L(48,32,61,32)}${P("M28 8 L34 8","power")}`,active);
    if (s==="boiler") return svg(`${R(12,9,40,46,7,"body")}${P("M32 46 C20 39 24 29 32 20 C40 29 44 39 32 46 Z","flame")}${L(3,18,12,18,"cold")}${L(52,18,61,18,"hot")}`,active);
    if (s==="burner") return svg(`${R(9,20,46,25,4,"body")}${C(22,32,8,"accent")}${P("M30 32 L47 24 L47 40 Z","flame")}`,active);
    if (["underfloor","heating_circuit"].includes(s)) return svg(`${R(8,12,48,40,4,"body")}${P("M14 38 C18 20 25 20 29 38 C33 20 40 20 50 38","hot")}${L(4,43,12,43,"cold")}${L(52,20,60,20,"hot")}`,active);
    if (s==="radiator") return svg(`${R(8,14,48,36,4,"body")}${[16,24,32,40,48].map(x=>L(x,18,x,46,"thin")).join("")}${L(2,43,8,43,"cold")}${L(56,21,62,21,"hot")}`,active);
    if (["fan","fan_supply","fan_extract"].includes(s)) return svg(`${C(32,32,22,"body")}${P("M32 31 C31 18 38 12 45 15 C45 23 40 29 33 32 M33 33 C45 35 49 42 44 48 C36 46 32 40 32 34 M31 33 C23 44 15 45 11 38 C15 31 22 29 30 32","accent rotor")}`,active,"fan");
    if (["damper","fire_damper"].includes(s)) return svg(`${R(7,18,50,28,1,"body")}${L(12,42,52,22,s==="fire_damper"?"alarm":"accent")}${C(32,32,3,"accent")}${s==="fire_damper"?'<text x="43" y="15" class="alarm txt">BSK</text>':""}`,active);
    if (["heating_coil","cooling_coil"].includes(s)) return svg(`${R(9,12,46,40,2,"body")}${P("M16 42 C23 42 18 22 26 22 C34 22 29 42 37 42 C45 42 40 22 48 22",s==="cooling_coil"?"cold":"hot")}`,active);
    if (s==="heat_recovery_rotary") return svg(`${C(32,32,22,"body")}${P("M32 11 L32 53 M11 32 L53 32 M17 17 L47 47 M47 17 L17 47","thin")}${C(32,32,5,"accent rotor")}`,active,"rotary");
    if (s==="humidifier") return svg(`${R(9,14,46,36,2,"body")}${P("M20 40 C12 31 20 22 20 22 C20 22 28 31 20 40 Z M34 43 C26 34 34 25 34 25 C34 25 42 34 34 43 Z M46 36 C40 29 46 22 46 22 C46 22 52 29 46 36 Z","accent")}`,active);
    if (s==="silencer") return svg(`${R(7,16,50,32,2,"body")}${[15,23,31,39,47].map(x=>L(x,19,x+6,45,"thin")).join("")}`,active);
    if (["heat_pump","heat_pump_neo","heat_pump_compact","chiller"].includes(s)) return svg(`${R(10,7,44,50,8,"body")}${C(32,32,14,"accent")}${P("M23 34 C26 24 38 24 41 34 M22 39 L42 39","thin")}${L(3,18,10,18,"cold")}${L(54,18,61,18,"hot")}`,active);
    if (s==="compressor") return svg(`${C(32,32,23,"body")}${P("M20 40 C25 22 41 20 45 32 C48 42 31 49 24 36","accent")}`,active);
    if (s==="cooling_tower") return svg(`${P("M18 8 L46 8 L52 56 L12 56 Z","body")}${P("M18 24 C26 18 38 18 46 24 M15 39 C25 33 39 33 49 39","cold")}`,active);
    if (["pv","pv_array"].includes(s)) return svg(`${P("M10 20 L48 12 L55 44 L17 52 Z","body")}${[20,30,40].map(x=>L(x,18,x+7,47,"thin")).join("")}${L(13,31,52,23,"thin")}${L(16,42,55,34,"thin")}${P("M8 9 L13 14 M3 20 L10 21 M19 3 L20 10","power")}`,active);
    if (s==="inverter") return svg(`${R(10,12,44,40,6,"body")}${P("M16 31 C21 22 27 40 32 31 C37 22 43 40 48 31","accent")}${L(3,32,10,32,"power")}${L(54,32,61,32,"power")}`,active);
    if (s==="battery") return svg(`${R(12,15,40,34,5,"body")}${R(26,9,12,6,2,"body")}${R(17,21,30,22,3,"batteryfill")}${L(21,32,43,32,"thin")}`,active);
    if (s==="grid") return svg(`${L(32,5,32,59,"body")}${L(18,20,46,20,"body")}${L(13,35,51,35,"body")}${L(18,20,9,59,"thin")}${L(46,20,55,59,"thin")}${L(32,20,18,59,"thin")}${L(32,20,46,59,"thin")}`,active);
    if (["meter","temp_sensor","pressure_sensor","dp_sensor","flow_sensor","humidity_sensor","co2_sensor","frost_thermostat"].includes(s)) {
      const label=s==="temp_sensor"?"T":s==="pressure_sensor"?"P":s==="dp_sensor"?"ΔP":s==="flow_sensor"?"F":s==="humidity_sensor"?"%":s==="co2_sensor"?"CO₂":s==="frost_thermostat"?"FROST":"M";
      return svg(`${C(32,32,22,"body")}${L(7,32,10,32)}${L(54,32,57,32)}<text x="32" y="36" text-anchor="middle" class="txt accent-text">${label}</text>`,active);
    }
    return null;
  }

  const DETAIL_STYLES = `
    .glt-detail-symbol{display:grid;width:100%;height:100%;place-items:center}.glt-detail-svg{width:35px;height:35px;overflow:visible;stroke:currentColor;stroke-width:2.2;fill:none;stroke-linecap:round;stroke-linejoin:round}.glt-detail-svg .thin{opacity:.55;stroke-width:1.35}.glt-detail-svg .body{stroke:currentColor}.glt-detail-svg .accent,.glt-detail-svg .accent-text{stroke:var(--glt-accent);color:var(--glt-accent);fill:var(--glt-accent)}.glt-detail-svg .hot{stroke:#ef4444}.glt-detail-svg .cold{stroke:#3b82f6}.glt-detail-svg .power{stroke:#eab308}.glt-detail-svg .alarm{stroke:#ef4444;fill:#ef4444}.glt-detail-svg .tank{stroke:currentColor;fill:color-mix(in srgb,var(--glt-accent-soft) 35%,transparent)}.glt-detail-svg .hotfill{fill:#ef444420;stroke:none}.glt-detail-svg .coldfill{fill:#3b82f620;stroke:none}.glt-detail-svg .batteryfill{fill:#22c55e33;stroke:#22c55e}.glt-detail-svg .flame{fill:#f9731640;stroke:#f97316}.glt-detail-svg .actuator{fill:color-mix(in srgb,var(--glt-accent) 18%,transparent);stroke:var(--glt-accent)}.glt-detail-svg .txt{font:700 8px system-ui,sans-serif;stroke:none;fill:currentColor}.glt-detail-svg.is-active .rotor{transform-box:fill-box;transform-origin:center;animation:gltDetailSpin 1.2s linear infinite}.glt-detail-svg.rotary.is-active .rotor{animation-duration:2s}@keyframes gltDetailSpin{to{transform:rotate(360deg)}}
    .glt-object-dialog{position:fixed;z-index:9999;inset:0;display:grid;place-items:center;background:#02061788;backdrop-filter:blur(5px)}.glt-object-panel{width:min(520px,calc(100vw - 26px));max-height:min(720px,calc(100vh - 40px));overflow:auto;border:1px solid var(--glt-border);border-radius:16px;background:var(--card-background-color);box-shadow:0 28px 90px #0009;color:var(--primary-text-color)}.glt-object-head{display:flex;align-items:center;gap:12px;padding:14px;border-bottom:1px solid var(--glt-border)}.glt-object-head .glt-detail-symbol{width:48px;height:48px;border:1px solid var(--glt-border);border-radius:12px;background:var(--glt-accent-soft)}.glt-object-head .glt-detail-svg{width:38px;height:38px}.glt-object-head b{display:block;font-size:14px}.glt-object-head small{display:block;color:var(--secondary-text-color);font-size:10px;margin-top:2px}.glt-object-close{margin-left:auto;border:1px solid var(--glt-border);background:transparent;color:var(--secondary-text-color);width:32px;height:32px;border-radius:9px;cursor:pointer}.glt-object-body{padding:14px}.glt-object-state{display:flex;align-items:end;justify-content:space-between;padding:11px;border:1px solid var(--glt-border);border-radius:12px;background:var(--glt-panel)}.glt-object-state strong{font-size:22px}.glt-object-state span{font-size:10px;color:var(--secondary-text-color)}.glt-object-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:9px}.glt-object-field{padding:8px;border:1px solid var(--glt-border);border-radius:9px}.glt-object-field small{display:block;color:var(--secondary-text-color);font-size:9px}.glt-object-field b{font-size:12px}.glt-object-controls{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.glt-object-controls button{border:1px solid var(--glt-border);background:var(--glt-panel);color:var(--primary-text-color);padding:8px 11px;border-radius:9px;cursor:pointer}.glt-object-controls button.primary{background:var(--glt-accent-soft);border-color:color-mix(in srgb,var(--glt-accent) 45%,var(--glt-border));color:var(--glt-accent)}.glt-object-controls button.danger{color:#ef4444}.glt-object-controls input,.glt-object-controls select{min-height:34px;border:1px solid var(--glt-border);border-radius:8px;background:var(--card-background-color);color:var(--primary-text-color);padding:0 8px}.glt-object-note{font-size:9px;color:var(--secondary-text-color);margin-top:10px}
    ha-card.glt-style-standard_2d{--card-background-color:#edf0f2;--primary-text-color:#17212b;--secondary-text-color:#5f6d79;--divider-color:#bec8d0;--glt-accent:#0d6a8e;--glt-accent-soft:#0d6a8e12;background:#e8ecef;color:#17212b;border:1px solid #aeb8c0;box-shadow:none}.glt-style-standard_2d .glt-viewport,.glt-style-standard_2d .glt-canvas{background:#f4f6f7;background-image:none}.glt-style-standard_2d .glt-equipment{background:#f7f8f9;border-color:#aeb8c0;border-radius:4px;box-shadow:0 2px 6px #0001;backdrop-filter:none}.glt-style-standard_2d .glt-eq-symbol{border-radius:3px;background:#e7ecef;border:1px solid #aeb8c0}.glt-style-standard_2d .glt-pipe{filter:none;stroke-linecap:butt;stroke-linejoin:miter}
    ha-card.glt-style-pid_dark{--card-background-color:#101316;--primary-text-color:#e5e7eb;--secondary-text-color:#9ca3af;--divider-color:#363b40;--glt-accent:#67e8f9;--glt-accent-soft:#67e8f910;background:#0b0e10;color:#e5e7eb;border:1px solid #343a40;border-radius:3px!important;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.glt-style-pid_dark .glt-viewport,.glt-style-pid_dark .glt-canvas{background:#0d1012;background-image:linear-gradient(#ffffff07 1px,transparent 1px),linear-gradient(90deg,#ffffff07 1px,transparent 1px);background-size:24px 24px}.glt-style-pid_dark .glt-equipment{background:#111517;border-color:#495057;border-radius:2px;box-shadow:none;backdrop-filter:none}.glt-style-pid_dark .glt-eq-symbol{border-radius:2px;background:#0b0e10;border:1px solid #495057}.glt-style-pid_dark .glt-pipe{filter:none;stroke-width:4px}.glt-style-pid_dark .glt-kpi{border-radius:2px}
    ha-card.glt-style-operations_light{--card-background-color:#fff;--primary-text-color:#182231;--secondary-text-color:#64748b;--divider-color:#d7e0e7;--glt-accent:#087f8c;--glt-accent-soft:#087f8c10;background:#f7fafc;color:#182231;border:1px solid #d8e2e8;box-shadow:0 18px 60px #1e3a5f16}.glt-style-operations_light .glt-viewport{background:#eef4f7}.glt-style-operations_light .glt-canvas{background:#fff;background-image:linear-gradient(#edf2f6 1px,transparent 1px),linear-gradient(90deg,#edf2f6 1px,transparent 1px);background-size:30px 30px}.glt-style-operations_light .glt-equipment{background:#fff;border-color:#d3dee6;box-shadow:0 8px 24px #1e3a5f12}.glt-style-operations_light .glt-eq-symbol{background:#eaf6f6}
  `;

  function entityId(item){const v=item?.control_entity||item?.entity;return typeof v==="string"?v:v?.entity||"";}
  function state(card,id){return id&&card?._hass?.states?.[id]||null:null;}
  function domain(id){return String(id||"").split(".")[0]||"";}
  function isControllable(card,id){const d=domain(id);return !!(id&&card?._hass&&["switch","light","fan","input_boolean","button","input_button","cover","valve","lock","number","input_number","select","input_select","climate","humidifier","water_heater","automation","script","scene"].includes(d));}
  // Retired (04-13). This returned true whenever no permission list was
  // configured at all -- an unconfigured card granted everyone control. It is
  // the first defect the roadmap names for this phase.
  function canOperate(){return false;}
  function displayState(card,id){const st=state(card,id);if(!st)return id?"Nicht verfügbar":"Keine Entity";const unit=st.attributes?.unit_of_measurement;return `${st.state}${unit?` ${unit}`:""}`;}
  // Retired (04-13): no browser path may reach hass.callService. Phase 2
  // resolves a control id to a domain, service and target from the verified
  // head; a browser holding those would be the direct fallback it closed.
  function service(){return undefined;}
  // Retired (04-13): window.confirm standing in for authorization, and
  // skippable by config. Phase 2's glt-flow-card-control-confirm confirms an
  // already-authorized, server-resolved control instead.
  function confirmControl(){return false;}
  function audit(card,action,detail){try{card?._glt4Store?.audit?.(action,detail);}catch(_e){}}

  // Retired (04-13). This ran a browser role check, a window.confirm, and then
  // dispatched a Home Assistant service directly. Every one of those is an
  // authority the Companion owns. It stays reachable and inert so the effect
  // ledger can prove it.
  async function command(card,item,cmd){audit(card,"control.blocked",{equipment_id:item?.id,command:cmd,reason:"legacy_command_retired"});}

  function controls(card,item,id,st){const d=domain(id),a=st?.attributes||{};if(!isControllable(card,id))return `<button class="primary" data-more>Mehr Informationen</button>`;
    if(["switch","light","input_boolean","automation"].includes(d))return '<button class="primary" data-cmd="on">Ein</button><button data-cmd="off">Aus</button><button data-cmd="toggle">Umschalten</button>';
    if(d==="fan")return `<button class="primary" data-cmd="on">Ein</button><button data-cmd="off">Aus</button>${a.percentage!=null?`<input data-fan type="number" min="0" max="100" step="1" value="${a.percentage||0}"><button data-cmd="set-fan">% setzen</button>`:""}`;
    if(["button","input_button"].includes(d))return '<button class="primary" data-cmd="press">Ausführen</button>';
    if(["cover","valve"].includes(d))return '<button class="primary" data-cmd="open">Öffnen</button><button data-cmd="stop">Stop</button><button data-cmd="close">Schließen</button>';
    if(d==="lock")return '<button class="primary" data-cmd="unlock">Entriegeln</button><button data-cmd="lock">Verriegeln</button>';
    if(["number","input_number"].includes(d))return `<input data-number type="number" min="${a.min??0}" max="${a.max??100}" step="${a.step??1}" value="${st?.state??0}"><button class="primary" data-cmd="set-number">Setzen</button>`;
    if(["select","input_select"].includes(d)){const opts=a.options||[];return `<select data-select>${opts.map(o=>`<option ${o===st?.state?"selected":""}>${o}</option>`).join("")}</select><button class="primary" data-cmd="set-select">Setzen</button>`;}
    if(d==="climate")return `<input data-temp type="number" step="0.5" value="${a.temperature??a.current_temperature??20}"><button class="primary" data-cmd="set-temp">Solltemperatur</button>${(a.hvac_modes||[]).length?`<select data-hvac>${a.hvac_modes.map(o=>`<option ${o===st?.state?"selected":""}>${o}</option>`).join("")}</select><button data-cmd="set-hvac">Betriebsart</button>`:""}`;
    if(["script","scene"].includes(d))return '<button class="primary" data-cmd="on">Ausführen</button>';
    return '<button class="primary" data-more>Mehr Informationen</button>';
  }

  function openControl(card,item){const root=card.shadowRoot;root.querySelector(".glt-object-dialog")?.remove();const id=entityId(item),st=state(card,id);const active=item.state_entity?card._isActive?.(item.state_entity):id?card._isActive?.(id):item.active!==false;const icon=symbolSvg(item.symbol||item.type,!!active)||"";const fields=(item.fields||[]).slice(0,8).map(f=>{const x=typeof f==="string"?{entity:f}:f;const eid=typeof x.entity==="string"?x.entity:x.entity?.entity||"";return `<div class="glt-object-field"><small>${x.label||x.name||eid}</small><b>${displayState(card,eid)}</b></div>`;}).join("");const wrap=document.createElement("div");wrap.className="glt-object-dialog";wrap.innerHTML=`<div class="glt-object-panel"><div class="glt-object-head"><span class="glt-detail-symbol">${icon}</span><div><b>${item.name||item.id||"Anlagenobjekt"}</b><small>${id||item.type||""}</small></div><button class="glt-object-close" data-close>✕</button></div><div class="glt-object-body"><div class="glt-object-state"><div><span>Aktueller Zustand</span><strong>${displayState(card,id)}</strong></div><span>${canOperate(card)?"Bedienbar":"Nur Lesen"}</span></div>${fields?`<div class="glt-object-fields">${fields}</div>`:""}<div class="glt-object-controls">${controls(card,item,id,st)}</div><div class="glt-object-note">Bedienung erfolgt über Home Assistant Services. Berechtigungen und optionale Sicherheitsabfrage werden berücksichtigt.</div></div></div>`;root.appendChild(wrap);wrap.onclick=e=>{if(e.target===wrap)wrap.remove();};wrap.querySelector("[data-close]").onclick=()=>wrap.remove();wrap.querySelector("[data-more]")?.addEventListener("click",()=>card._openMoreInfo?.(id));wrap.querySelectorAll("[data-cmd]").forEach(b=>b.onclick=()=>command(card,item,b.dataset.cmd,wrap));}

  async function runTap(card,item,tap){const id=entityId(item);const action=typeof tap==="string"?tap:(tap?.action||"control");if(action==="none")return;if(action==="control")return openControl(card,item);if(action==="more-info")return card._openMoreInfo?.(id);if(action==="toggle")return card._tapEntity?.(id);if(action==="call-service"||action==="perform-action"){/* Retired (04-13): this split a caller-supplied service string and passed caller-supplied data and target straight to hass.callService. Phase 2 retired the equivalent server route; this was its browser twin. */audit(card,"control.blocked",{equipment_id:item?.id,reason:"legacy_tap_action_retired"});return;}if(action==="navigate"&&tap.navigation_path){history.pushState(null,"",tap.navigation_path);window.dispatchEvent(new Event("location-changed"));return;}if(action==="url"&&tap.url_path)window.open(tap.url_path,tap.new_tab===false?"_self":"_blank");}

  const oldMarkup=Card.prototype._equipmentMarkup;
  Card.prototype._equipmentMarkup=function(item){let html=oldMarkup.call(this,item);if(item.image)return html;const active=item.state_entity?this._isActive?.(item.state_entity):item.entity?this._isActive?.(item.entity):item.active!==false;const detailed=symbolSvg(item.symbol||item.type,!!active);if(!detailed)return html;return html.replace(/<ha-icon class="glt-eq-icon"[^>]*><\/ha-icon>/,`<span class="glt-detail-symbol">${detailed}</span>`);};

  const oldRenderEquipment=Card.prototype._renderEquipment;
  Card.prototype._renderEquipment=function(canvas){const result=oldRenderEquipment.call(this,canvas);const items=(this._config.equipment||[]).filter(i=>this._visibleInView?.(i)!==false);Array.from(canvas.querySelectorAll(".glt-equipment")).forEach((node,index)=>{const item=items[index];if(!item)return;node.dataset.equipmentId=item.id||"";const id=entityId(item),tap=item.tap_action;const needsControl=(typeof tap==="object")||tap==="control"||tap==="none"||(!tap&&isControllable(this,id));if(needsControl){node.addEventListener("click",e=>{if(e.target.closest(".glt-eq-row"))return;e.stopImmediatePropagation();e.stopPropagation();runTap(this,item,tap||"control");},true);}});return result;};

  function addStyles(root){if(root.querySelector("style[data-glt-detail]"))return;const st=document.createElement("style");st.dataset.gltDetail="1";st.textContent=DETAIL_STYLES;root.appendChild(st);}
  function addDesignButtons(card){const sw=card.shadowRoot.querySelector(".glt-style-switch");if(!sw)return;[["standard_2d","Standard 2D"],["operations_light","Operations"],["pid_dark","P&ID"]].forEach(([id,label])=>{if(sw.querySelector(`[data-style="${id}"]`))return;const b=document.createElement("button");b.type="button";b.dataset.style=id;b.textContent=label;b.classList.toggle("active",(card._styleMode||card._config?.appearance?.mode)===id);b.onclick=()=>{card._styleMode=id;card._queueRender?.();};sw.appendChild(b);});}
  const oldRender=Card.prototype._render;
  Card.prototype._render=function(){const r=oldRender.call(this);addStyles(this.shadowRoot);addDesignButtons(this);return r;};

  function picker(editor,value,onChange){const p=document.createElement("ha-entity-picker");p.hass=editor._hass;p.value=value||"";p.addEventListener("value-changed",e=>onChange(e.detail?.value||""));return p;}
  function detailInspector(editor){const root=editor.shadowRoot,ins=root.querySelector(".insp"),obj=editor._obj?.();if(!ins||!obj||editor._sel?.k!=="equipment"||ins.querySelector("[data-detail-inspector]"))return;const sec=document.createElement("div");sec.className="sec";sec.dataset.detailInspector="1";const currentTap=typeof obj.tap_action==="string"?obj.tap_action:obj.tap_action?.action||"control";sec.innerHTML=`<div class="st">GLT Symbol & Bedienung <span class="chip">Detail</span></div><label>Detail-Symbol<select data-detail-symbol>${DETAIL_SYMBOLS.map(([id,label,cat])=>`<option value="${id}" ${obj.symbol===id?"selected":""}>${cat} · ${label}</option>`).join("")}</select></label><label>Aktion bei Klick<select data-tap><option value="control">Objektbedienung öffnen</option><option value="more-info">HA Mehr-Info</option><option value="toggle">Direkt umschalten</option><option value="call-service">Service aufrufen</option><option value="none">Keine Aktion</option></select></label><label>Steuer-Entity<div data-control-picker></div></label><label>Status-Entity<div data-state-picker></div></label><label>Service (optional)<input data-service placeholder="domain.service" value="${typeof obj.tap_action==="object"?(obj.tap_action.service||""):""}"></label><label>Service-Daten JSON<input data-service-data placeholder='{"entity_id":"..."}' value='${typeof obj.tap_action==="object"&&obj.tap_action.data?JSON.stringify(obj.tap_action.data).replaceAll("'","&#39;"):""}'></label>`;sec.querySelector("[data-tap]").value=currentTap;sec.querySelector("[data-detail-symbol]").onchange=e=>{editor._remember?.();obj.symbol=e.target.value;editor._emit?.();editor._render?.();};sec.querySelector("[data-tap]").onchange=e=>{editor._remember?.();const v=e.target.value;obj.tap_action=v==="call-service"?{action:v,service:sec.querySelector("[data-service]").value||"",data:{}}:v;editor._emit?.();editor._render?.();};const saveService=()=>{if((typeof obj.tap_action==="object"?obj.tap_action.action:obj.tap_action)!=="call-service")return;let data={};try{data=JSON.parse(sec.querySelector("[data-service-data]").value||"{}");}catch(_e){}obj.tap_action={action:"call-service",service:sec.querySelector("[data-service]").value||"",data};editor._emit?.();};sec.querySelector("[data-service]").onchange=saveService;sec.querySelector("[data-service-data]").onchange=saveService;const cp=picker(editor,entityId(obj),v=>{editor._remember?.();obj.control_entity=v||undefined;editor._emit?.();});sec.querySelector("[data-control-picker]").appendChild(cp);const sp=picker(editor,typeof obj.state_entity==="string"?obj.state_entity:obj.state_entity?.entity||"",v=>{editor._remember?.();obj.state_entity=v||undefined;editor._emit?.();});sec.querySelector("[data-state-picker]").appendChild(sp);ins.prepend(sec);}
  function designInspector(editor){const root=editor.shadowRoot,ins=root.querySelector(".insp");if(!ins||ins.querySelector("[data-design-library]"))return;const sec=document.createElement("div");sec.className="sec";sec.dataset.designLibrary="1";sec.innerHTML=`<div class="st">Designbibliothek <span class="chip">6 Presets</span></div><select data-design><option value="neo2030">Neo 2030</option><option value="clean">Clean</option><option value="classic_scada">Classic SCADA</option><option value="standard_2d">Standard 2D</option><option value="operations_light">Operations Light</option><option value="pid_dark">P&ID Dark</option></select>`;sec.querySelector("select").value=editor._config?.appearance?.mode||"neo2030";sec.querySelector("select").onchange=e=>{editor._remember?.();editor._config.appearance=editor._config.appearance||{};editor._config.appearance.mode=e.target.value;editor._emit?.();editor._render?.();};ins.prepend(sec);}
  const oldEditorRender=Editor.prototype._render;
  Editor.prototype._render=function(){const r=oldEditorRender.call(this);detailInspector(this);designInspector(this);return r;};

  window.GLT_FLOW_DETAIL_SYMBOLS = DETAIL_SYMBOLS.map(([id,label,category])=>({id,label,category}));
  console.info("GLT Flow Card: deep GLT symbols, 6 visual presets and equipment control panels enabled.");
})();
